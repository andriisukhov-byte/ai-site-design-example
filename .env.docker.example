# Copy to .env.docker. Do not commit the copied file.
PAYLOAD_SECRET=replace-with-a-long-random-secret

POSTGRES_DB=acme
POSTGRES_USER=acme
POSTGRES_PASSWORD=replace-local-postgres-password

# Browser forms post directly to Formspree; there is no form API container.
PUBLIC_FORM_ENDPOINT_CONTACT=https://formspree.io/f/YOUR_FORM_ID
PUBLIC_FORM_ENDPOINT_ENTERPRISE=https://formspree.io/f/YOUR_FORM_ID
PUBLIC_FORM_ENDPOINT_BLOG_SUBSCRIBE=https://formspree.io/f/YOUR_FORM_ID
PUBLIC_FORM_ENDPOINT_REQUEST_DEMO=https://formspree.io/f/YOUR_FORM_ID
