# Browser-visible endpoint for the product-owned form API. Any unset per-intent
# endpoint falls back to this URL. Do not point browser forms directly at Formspree.
PUBLIC_FORM_ENDPOINT=/api/forms/submit
# Browser-visible PostHog project settings. The Project API Key is public by
# design; never put a personal PostHog API key here.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Browser-visible Google Tag Manager container. Leave empty to disable GTM.
PUBLIC_GTM_CONTAINER_ID=
# Optional origin for the single shared /media directory. Leave empty when the
# web server and media are on the same origin.
PUBLIC_MEDIA_BASE_URL=
PUBLIC_SITE_NOINDEX=false

# Server-only Payload REST endpoint used by Astro during dev/build.
PAYLOAD_API_URL=http://localhost:3000/api
# Fail the build instead of falling back to data/cms/pages.json.
PAYLOAD_API_REQUIRED=false

# Server-side form API settings. Do not expose these with PUBLIC_ prefixes.
FORM_NOTIFICATION_PROVIDER=
FORM_NOTIFICATION_FROM=
FORM_NOTIFICATION_TO_CONTACT=
FORM_NOTIFICATION_TO_DEMO=
FORM_NOTIFICATION_TO_ENTERPRISE=
FORM_CRM_WEBHOOK_URL=
FORM_CRM_WEBHOOK_SECRET=
FORM_SUBMISSION_LOG_PATH=.tmp/form-submissions.ndjson
FORM_API_PORT=8787
FORM_API_PATH=/api/forms/submit
FORM_API_ALLOWED_ORIGIN=http://localhost:4321
FORM_PAYLOAD_API_URL=http://localhost:3000
FORM_SUBMISSION_SECRET=
# Server-side delivery endpoints. They are intentionally not PUBLIC_ variables.
FORMSPREE_ENDPOINT_CONTACT=https://formspree.io/f/YOUR_FORM_ID
FORMSPREE_ENDPOINT_ENTERPRISE=https://formspree.io/f/YOUR_FORM_ID
FORMSPREE_ENDPOINT_BLOG_SUBSCRIBE=https://formspree.io/f/YOUR_FORM_ID
FORMSPREE_ENDPOINT_REQUEST_DEMO=https://formspree.io/f/YOUR_FORM_ID
