{
  "name": "acme-clean-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bash tools/dev/setup-local.sh",
    "dev": "concurrently -n cms,web,forms -c blue,green,magenta \"npm run dev:cms\" \"npm run dev:web:after-cms\" \"npm run dev:forms\"",
    "dev:cms": "cross-env PAYLOAD_DB_PUSH=false npm --workspace @acme/cms run dev",
    "dev:web": "npm --workspace @acme/web run dev",
    "dev:web:after-cms": "cross-env PAYLOAD_API_URL=http://127.0.0.1:3000/api PAYLOAD_API_REQUIRED=true tsx tools/dev/wait-for-payload.ts && npm run dev:web",
    "dev:forms": "tsx apps/web/src/server/form-api-server.ts",
    "docker:local:setup": "docker compose --env-file .env.docker -f docker-compose.local.yml run --rm npm-deps && docker compose --env-file .env.docker -f docker-compose.local.yml run --rm cms-init && docker compose --env-file .env.docker -f docker-compose.local.yml run --rm --no-deps cms npm run migrate:source:upsert -- --write true --progress 100",
    "docker:local:up": "docker compose --env-file .env.docker -f docker-compose.local.yml up -d",
    "docker:local:down": "docker compose --env-file .env.docker -f docker-compose.local.yml down",
    "deploy:spaces": "tsx tools/deploy/upload-spaces.ts",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "npm --workspaces run lint",
    "format": "prettier --write .",
    "agent:dispatch": "tsx tools/agents/agent-dispatcher.ts",
    "agent:dispatch:test": "tsx tools/agents/agent-dispatcher.test.ts",
    "agent:runtime:test": "tsx tools/agents/agent-runtime.test.ts",
    "agent:supervise": "tsx tools/agents/team-supervisor.ts",
    "agent:tasks": "tsx tools/agents/task-queue.ts",
    "agent:tasks:test": "tsx tools/agents/task-queue.test.ts",
    "agent:verify": "npm run agent:tasks:test && npm run agent:dispatch:test && npm run agent:runtime:test && tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck tools/agents/task-queue.ts tools/agents/task-queue.test.ts tools/agents/agent-dispatcher.ts tools/agents/agent-dispatcher.test.ts tools/agents/team-supervisor.ts tools/agents/agent-runtime.test.ts",
    "ai:block-catalog": "tsx tools/ai/export-block-catalog.ts",
    "cms:upsert": "tsx tools/cms/upsert-content.ts",
    "cms:generate-use-cases": "tsx tools/cms/generate-use-case-pages.ts",
    "cms:navigation": "tsx tools/cms/update-site-navigation.ts",
    "cms:upsert-forms": "tsx tools/cms/upsert-forms.ts",
    "cms:export": "tsx tools/cms/export-content.ts",
    "cms:ensure-content-key": "tsx tools/cms/ensure-content-key-column.ts",
    "cms:ensure-article-fields": "tsx tools/cms/ensure-article-fields.ts",
    "cms:ensure-how-it-works-fields": "tsx tools/cms/ensure-how-it-works-fields.ts",
    "cms:media-handoff": "tsx tools/cms/export-media-handoff.ts",
    "cms:media-index": "tsx tools/cms/upsert-media.ts",
    "cms:media-migrate-storage": "tsx tools/cms/migrate-media-storage.ts",
    "cms:media-prune": "tsx tools/cms/prune-media.ts",
    "cms:media-usage": "tsx tools/cms/report-media-usage.ts",
    "cms:media-sync": "tsx tools/cms/sync-media-handoff.ts",
    "cms:snapshot": "tsx tools/cms/export-snapshot.ts",
    "migrate:source:inventory": "tsx tools/migrate/source-inventory.ts",
    "migrate:source:sanitize": "tsx tools/migrate/source-sanitize.ts",
    "migrate:source:tips-snapshot": "tsx tools/migrate/source-tips-snapshot.ts",
    "migrate:source:tips-sync": "tsx tools/migrate/source-tips-sync.ts",
    "migrate:source:production-articles": "tsx tools/migrate/production-article-sync.ts",
    "migrate:source:production-faq": "tsx tools/migrate/production-faq-sync.ts",
    "migrate:source:production-home": "tsx tools/migrate/production-home-sync.ts",
    "migrate:source:production-pricing": "tsx tools/migrate/production-pricing-sync.ts",
    "migrate:source:production-seo": "tsx tools/migrate/production-seo-sync.ts",
    "migrate:source:production-shared-blocks": "tsx tools/migrate/production-shared-block-sync.ts",
    "migrate:source:production-taxonomies": "tsx tools/migrate/production-taxonomy-snapshot.ts",
    "migrate:source:production-use-cases": "tsx tools/migrate/production-use-case-sync.ts",
    "migrate:source:guides-presentation-snapshot": "tsx tools/migrate/source-guides-presentation-snapshot.ts",
    "migrate:source:guide-taxonomy-snapshot": "tsx tools/migrate/source-guide-taxonomy-snapshot.ts",
    "migrate:source:export": "tsx tools/migrate/source-export.ts",
    "migrate:source:forms": "tsx tools/migrate/source-forms.ts",
    "migrate:source:upsert": "tsx tools/migrate/source-upsert.ts",
    "migrate:media:attachments": "tsx tools/migrate/media-attachments.ts",
    "migrate:media:recover": "tsx tools/migrate/media-recover-local.ts",
    "qa:visual": "tsx tools/qa/visual-compare.ts",
    "qa:visual-smoke": "tsx tools/qa/visual-compare.ts --out data/source/visual-smoke-latest --report-out data/source/visual-smoke-report.json",
    "qa:production-content": "tsx tools/qa/production-content-audit.ts",
    "qa:poc-readiness": "tsx tools/qa/poc-readiness.ts",
    "qa:poc-suite": "tsx tools/qa/poc-launch-suite.ts",
    "qa:content": "tsx tools/qa/content-health.ts",
    "qa:copy": "tsx tools/qa/copy-gate.ts",
    "qa:keyword-collision": "tsx tools/qa/keyword-collision.ts",
    "qa:copy-fidelity": "tsx tools/qa/copy-fidelity.ts",
    "qa:seo": "tsx tools/qa/seo-check.ts",
    "qa:links": "tsx tools/qa/link-check.ts",
    "qa:media": "tsx tools/qa/media-availability.ts",
    "qa:chrome": "tsx tools/qa/chrome-smoke.ts",
    "qa:block-dom": "tsx tools/qa/block-dom-smoke.ts",
    "qa:blocks-storybook": "tsx tools/qa/blocks-storybook-audit.ts",
    "qa:block-registry": "tsx tools/qa/block-registry-coverage.ts",
    "qa:block-root-attrs": "tsx tools/qa/block-root-attrs.ts",
    "qa:no-hotlinks": "tsx tools/qa/no-hotlinks.ts",
    "qa:no-inline-block-styles": "tsx tools/qa/no-inline-block-styles.ts",
    "qa:page-contract": "tsx tools/qa/page-contract.ts",
    "qa:payload-roundtrip": "tsx tools/qa/payload-roundtrip.ts",
    "qa:forms": "tsx tools/qa/forms.ts",
    "qa:form-api": "tsx tools/qa/form-api.ts",
    "qa:route-coverage": "tsx tools/qa/route-coverage.ts",
    "qa:empty-route-sources": "tsx tools/qa/empty-route-sources.ts",
    "qa:html-structure": "tsx tools/qa/html-structure.ts",
    "qa:site-index": "tsx tools/qa/site-index.ts",
    "qa:signup-links": "tsx tools/qa/signup-links.ts",
    "qa:toc": "tsx tools/qa/toc.ts",
    "qa:tips-dates": "tsx tools/qa/tips-dates.ts",
    "qa:archive-metadata": "tsx tools/qa/archive-metadata-readiness.ts",
    "qa:launch-readiness": "tsx tools/qa/launch-readiness.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.9",
    "concurrently": "9.2.1",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "prettier": "3.7.4",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "zod": "4.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
