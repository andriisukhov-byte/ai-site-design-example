{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "blocker", "summary", "tasks", "integrationNotes"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "question"],
          "properties": {
            "reason": {
              "type": "string"
            },
            "question": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "kind",
          "lane",
          "role",
          "priority",
          "baseBranch",
          "branch",
          "allowedFiles",
          "sharedFiles",
          "acceptance",
          "contextFiles",
          "dependsOn",
          "reasoningEffort",
          "delivery"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["orchestration", "implementation", "qa", "review"]
          },
          "lane": {
            "type": "string",
            "enum": ["web", "cms", "qa", "review"]
          },
          "role": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "baseBranch": {
            "type": "string"
          },
          "branch": {
            "type": "string",
            "pattern": "^codex/agent/"
          },
          "allowedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contextFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasoningEffort": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh"]
          },
          "delivery": {
            "type": "string",
            "enum": ["report", "commit", "push", "pull-request"]
          }
        }
      }
    },
    "integrationNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
