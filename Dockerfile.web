FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY . .
RUN npm ci

# SSR loads Payload content at request time. The checked-in snapshot only lets
# the image compile before the CMS container exists.
ENV PAYLOAD_API_REQUIRED=false
RUN npm run build --workspace @acme/web

FROM node:22-bookworm-slim AS production-dependencies

WORKDIR /app
COPY . .
RUN npm ci --omit=dev --workspace @acme/web --include-workspace-root=false

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=production-dependencies /app/packages ./packages

EXPOSE 4321
CMD ["node", "apps/web/dist/server/entry.mjs"]
