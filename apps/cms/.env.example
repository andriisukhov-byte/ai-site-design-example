# Local Docker: postgresql://acme:password@localhost:5432/acme
# Production: use the TLS connection string from DigitalOcean Managed PostgreSQL.
DATABASE_URL=postgresql://acme:password@localhost:5432/acme
PAYLOAD_SECRET=YOUR_SECRET_HERE
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Optional when a reverse proxy exposes Payload's API and Next assets below the
# mounted admin URL (for example, /admin/api and /admin/_next on staging).
PAYLOAD_API_ROUTE=/api
NEXT_ASSET_PREFIX=
# Optional CI/CD deploy hook. Payload calls it after content create/update/delete.
FRONTEND_DEPLOY_HOOK_URL=
FRONTEND_DEPLOY_HOOK_TOKEN=
# S3-compatible storage. Local Docker uses MinIO; production uses DO Spaces.
S3_BUCKET=acme-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=http://media.localhost
# Leave MCP enabled for local CMS-to-Codex integration.
PAYLOAD_MCP_DISABLED=false
# Create a unique local key; do not commit it. Codex receives this value through
# the PAYLOAD_MCP_API_KEY environment variable (see the repository README).
PAYLOAD_MCP_API_KEY=
# Must match FORM_SUBMISSION_SECRET in the form API environment. It authorizes
# the form API to create Form Submission records without a CMS user session.
FORM_SUBMISSION_SECRET=
