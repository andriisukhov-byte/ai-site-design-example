---
import '../../../styles/blocks/_anchor-pills.scss';

interface AnchorPillItem {
  icon?: string;
  label?: string;
  anchor?: string;
}

interface Props {
  block: {
    background?: 'white' | 'gray';
    items?: AnchorPillItem[];
  };
}

const { block } = Astro.props;
const items = (block.items ?? []).filter((item) => Boolean(item.label?.trim()));
const background = block.background === 'gray' ? 'gray' : 'white';
const iconStrokeAttrs = 'stroke="url(#anchor-pills-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';

const iconPaths: Record<string, string> = {
  'square-arrow-left': '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m12 8-4 4 4 4M16 12H8"/>',
  'shopping-bag': '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  coins: '<circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/>',
  'audio-lines': '<path d="M2 10v3M6 6v11M10 3v18M14 8v7M18 5v13M22 10v3"/>',
  'package-search': '<path d="M16 16v6M16 22l-4-3 4-3M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73L11 22"/><path d="m7.5 4.27 9 5.15M3.29 7 12 12 20.71 7M12 22V12"/>',
  tag: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
  receipt: '<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8M12 17.5v-11"/>',
  'bell-dot': '<path d="M19.4 14.9C20.2 16.4 21 17 21 17H3s3-2 3-9c0-3.3 2.7-6 6-6 .7 0 1.3.1 2 .3M10.3 21a1.94 1.94 0 0 0 3.4 0"/><circle cx="18" cy="8" r="3"/>',
  'file-box': '<path d="M14.5 22H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v3"/><path d="M14 2v4a2 2 0 0 0 2 2h4M2.97 13.12c-.6.36-.97 1.02-.97 1.74v3.28c0 .72.37 1.38.97 1.74l3 1.83c.63.39 1.43.39 2.06 0l3-1.83c.6-.36.97-1.02.97-1.74v-3.28c0-.72-.37-1.38-.97-1.74l-3-1.83a1.97 1.97 0 0 0-2.06 0zM7 17l-4.74-2.85M7 17l4.74-2.85M7 17v5"/>',
  boxes: '<path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3zM7 16.5l-4.74-2.85M7 16.5l5-3M7 16.5v5.17M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3M17 16.5l-5-3M17 16.5l4.74-2.85M17 16.5v5.17M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0zM12 8 7.26 5.15M12 8l4.74-2.85M12 13.5V8"/>',
  'triangle-alert': '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4M12 17h.01"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  'message-square': '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  'calendar-check': '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/>',
  house: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM9 22V12h6v10"/>',
  'list-checks': '<path d="m3 17 2 2 4-4M3 7l2 2 4-4M13 6h8M13 12h8M13 18h8"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0"/>',
};

function iconMarkup(name?: string): string {
  const body = iconPaths[name ?? 'tag'] ?? iconPaths.tag;
  return `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" ${iconStrokeAttrs} aria-hidden="true" focusable="false">${body}</svg>`;
}

function targetAnchor(value?: string): string | undefined {
  const anchor = value?.replace(/^[#\s]+|[#\s]+$/g, '');
  return anchor ? `#${anchor}` : undefined;
}
---

{items.length > 0 && (
  <section class:list={['anchor-pills', `anchor-pills--${background}`]}>
    <svg class="anchor-pills__svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="anchor-pills-gradient" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#3A87D9" />
          <stop offset="0.25" stop-color="#2F1A6B" />
          <stop offset="0.5" stop-color="#200000" />
          <stop offset="0.75" stop-color="#AD3822" />
          <stop offset="1" stop-color="#F7A75F" />
        </linearGradient>
      </defs>
    </svg>
    <div class="anchor-pills__container container-wide">
      <ul class="anchor-pills__list">
        {items.map((item) => {
          const href = targetAnchor(item.anchor);
          return (
            <li class="anchor-pills__item">
              {href ? (
                <a class="anchor-pills__pill" href={href}>
                  <span class="anchor-pills__icon" aria-hidden="true" set:html={iconMarkup(item.icon)} />
                  <span class="anchor-pills__label">{item.label?.trim()}</span>
                </a>
              ) : (
                <span class="anchor-pills__pill anchor-pills__pill--static">
                  <span class="anchor-pills__icon" aria-hidden="true" set:html={iconMarkup(item.icon)} />
                  <span class="anchor-pills__label">{item.label?.trim()}</span>
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
