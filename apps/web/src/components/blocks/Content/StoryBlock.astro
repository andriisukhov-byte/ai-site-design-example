---
import type { PageBlock } from '@acme/blocks';
import '../../../styles/blocks/_story.scss';

type StoryBlock = Extract<PageBlock, { type: 'story' }>;

interface Props {
  block: StoryBlock;
}

const { block } = Astro.props;

function formatMultiline(value: string): string {
  return escapeHtml(value).replace(/\r?\n/g, '<br />');
}

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

const storyIcons: Record<string, string> = {
  'message-square-text': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10ZM7 9h10M7 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  bot: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 8V4M8 12h8M8 12a4 4 0 1 1 8 0v4a4 4 0 0 1-4 4h0a4 4 0 0 1-4-4v-4ZM6 19v-3M18 19v-3M9 15h.01M15 15h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7-3a7 7 0 0 0-.12-1.31l2.12-1.65-2-3.46-2.49 1a7 7 0 0 0-2.27-1.31L14 3h-4l-.24 2.27a7 7 0 0 0-2.27 1.31l-2.49-1-2 3.46 2.12 1.65A7 7 0 0 0 5 12c0 .44.04.88.12 1.31L3 14.96l2 3.46 2.49-1c.69.55 1.46.99 2.27 1.31L10 21h4l.24-2.27c.81-.32 1.58-.76 2.27-1.31l2.49 1 2-3.46-2.12-1.65c.08-.43.12-.87.12-1.31Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  network: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="9" y="2" width="6" height="6" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="16" width="6" height="6" rx="1" stroke="currentColor" stroke-width="2"/><rect x="15" y="16" width="6" height="6" rx="1" stroke="currentColor" stroke-width="2"/><path d="M12 8v3M6 16v-3h12v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  'share-2': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="2"/><circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="2"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  sparkles: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m12 3 1.91 5.18L19 10l-5.09 1.82L12 17l-1.91-5.18L5 10l5.09-1.82L12 3ZM19 17l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2ZM5 17l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  'layout-template': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="9" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  globe: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM2 12h20M12 2c2.5 2.7 4 6.1 4 10s-1.5 7.3-4 10c-2.5-2.7-4-6.1-4-10s1.5-7.3 4-10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  'shield-check': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10ZM9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  'calendar-check': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  workflow: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="3" width="8" height="8" rx="1" stroke="currentColor" stroke-width="2"/><rect x="13" y="13" width="8" height="8" rx="1" stroke="currentColor" stroke-width="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
};

function storyIcon(name?: string): string {
  return storyIcons[name ?? 'message-square-text'] ?? storyIcons['message-square-text'];
}
---

<section class="story">
  <div class="story__container container-wide">
    <div class="story__top">
      <div class="story__copy">
        {block.eyebrow && <p class="story__eyebrow">{block.eyebrow}</p>}

        {(block.titleGradient || block.title) && (
          <h2 class="story__title">
            {block.titleGradient && <span class="story__title-gradient">{block.titleGradient}</span>}
            {block.title && <span class="story__title-line">{block.title}</span>}
          </h2>
        )}

        {block.intro && <p class="story__intro" set:html={formatMultiline(block.intro)} />}
        {block.bodyTop && <p class="story__body" set:html={formatMultiline(block.bodyTop)} />}

        {block.quote && (
          <blockquote class="story__quote">
            <span class="story__quote-bar" aria-hidden="true"></span>
            <p set:html={formatMultiline(block.quote)} />
          </blockquote>
        )}

        {block.bodyBottom && <p class="story__body" set:html={formatMultiline(block.bodyBottom)} />}
      </div>

      {block.image?.src && (
        <div class="story__visual">
          <img class="story__image" src={block.image.src} alt={block.image.alt} width={block.image.width} height={block.image.height} loading="lazy" decoding="async" />
        </div>
      )}
    </div>

    {block.cards.length > 0 && (
      <div class="story__grid">
        {block.cards.map((card) => (
          <article class="story__card">
            <div class="story__card-icon" aria-hidden="true">
              {card.customIcon?.src ? (
                <img class="story__card-custom-icon" src={card.customIcon.src} alt={card.customIcon.alt} width={card.customIcon.width} height={card.customIcon.height} loading="lazy" decoding="async" />
              ) : (
                <Fragment set:html={storyIcon(card.icon)} />
              )}
            </div>
            {card.title && <h3 class="story__card-title">{card.title}</h3>}
            {card.description && <p class="story__card-description">{card.description}</p>}
          </article>
        ))}
      </div>
    )}
  </div>
</section>
