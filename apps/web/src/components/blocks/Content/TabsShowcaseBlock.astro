---
import FormattedText from '../../FormattedText.astro';
import TabsShowcaseIsland, { type TabsShowcaseData } from './TabsShowcaseIsland';

import '../../../styles/blocks/_tabs-showcase.scss';
interface Props {
  block: TabsShowcaseData;
}

const { block } = Astro.props;
const tabs = block.tabs.filter((tab) => tab.label || tab.steps.length > 0);
const hasContent = tabs.length > 0 || block.title || block.eyebrow || block.subtitle;
const titlePlain = (block.title ?? '').replace(/\{\{|\}\}|\|\|/g, ' ').replace(/\s+/g, ' ').trim();
---

{hasContent && (
  <section class:list={['tabs-showcase', `tabs-showcase--${block.background ?? 'gray'}`]}>
    <div class="tabs-showcase__container container-wide">
      {(block.eyebrow || block.title || block.subtitle) && (
        <header class="tabs-showcase__header">
          {block.eyebrow && <p class="tabs-showcase__eyebrow">{block.eyebrow}</p>}
          {block.title && <h2 class="tabs-showcase__title"><FormattedText text={block.title} /></h2>}
          {block.subtitle && <p class="tabs-showcase__subtitle">{block.subtitle}</p>}
        </header>
      )}

      {tabs.length > 0 && (
        <TabsShowcaseIsland
          tabs={tabs}
          autoplayMs={Math.max(0, (block.autoplaySeconds ?? 0) * 1000)}
          ariaLabel={titlePlain || 'Workflow examples'}
          client:load
        />
      )}
    </div>
  </section>
)}
