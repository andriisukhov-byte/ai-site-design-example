---
import type { PageBlock } from '@acme/blocks';
import FormattedText from '../../FormattedText.astro';

import '../../../styles/blocks/_rich-text.scss';
type RichTextBlock = Extract<PageBlock, { type: 'rich-text' }>;

const { block } = Astro.props as { block: RichTextBlock };
const prepared = prepareRichText(block.html);

function prepareRichText(html: string): {
  html: string;
  toc: Array<{ id: string; text: string; level: 2 | 3 }>;
} {
  const usedIds = new Set<string>();
  const toc: Array<{ id: string; text: string; level: 2 | 3 }> = [];
  const withIds = html.replace(/<h([23])\b([^>]*)>([\s\S]*?)<\/h\1>/gi, (match, levelRaw: string, attrsRaw: string, content: string) => {
    const text = decodeEntities(stripTags(content)).replace(/\s+/g, ' ').trim();

    if (!text) {
      return match;
    }

    const level = Number(levelRaw) === 3 ? 3 : 2;
    const existingId = attrValue(attrsRaw, 'id');
    const baseId = existingId || slugify(text);
    const id = uniqueId(baseId, usedIds);
    const attrsWithoutId = attrsRaw.replace(/\s+id=(["']).*?\1/i, '').trim();
    const attrs = `${attrsWithoutId} id="${escapeAttribute(id)}" data-toc-heading`.replace(/\s+/g, ' ').trim();

    toc.push({ id, text, level });

    return `<h${level}${attrs ? ` ${attrs}` : ''}>${content}</h${level}>`;
  });

  return { html: withIds, toc };
}

function attrValue(attrs: string, name: string): string | undefined {
  const match = attrs.match(new RegExp(`\\s${name}=(["'])(.*?)\\1`, 'i'));
  return match?.[2]?.trim() || undefined;
}

function uniqueId(value: string, usedIds: Set<string>): string {
  const base = slugify(value) || 'section';
  let id = base;
  let index = 2;

  while (usedIds.has(id)) {
    id = `${base}-${index}`;
    index += 1;
  }

  usedIds.add(id);
  return id;
}

function slugify(value: string): string {
  return decodeEntities(value)
    .toLowerCase()
    .replace(/&amp;/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 80);
}

function stripTags(value: string): string {
  return value.replace(/<[^>]*>/g, '');
}

function decodeEntities(value: string): string {
  return value
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
}

function escapeAttribute(value: string): string {
  return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
}
---

<section class="rich-text-section ca-section">
  <div class="rich-text-section__inner ca-container">
    {block.eyebrow && <p class="eyebrow ca-eyebrow">{block.eyebrow}</p>}
    {block.title && <h2 class="ca-heading-md"><FormattedText text={block.title} /></h2>}
    <div class:list={['rich-text-section__layout', prepared.toc.length >= 3 && 'rich-text-section__layout--with-toc']}>
      {prepared.toc.length >= 3 && (
        <nav class="rich-text-toc" aria-label="Table of contents">
          <p class="rich-text-toc__title">Contents</p>
          <ol class="rich-text-toc__list">
            {prepared.toc.map((item) => (
              <li class:list={['rich-text-toc__item', `rich-text-toc__item--h${item.level}`]}>
                <a class="rich-text-toc__link" href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class="rich-text ca-prose" set:html={prepared.html} />
    </div>
  </div>
</section>
