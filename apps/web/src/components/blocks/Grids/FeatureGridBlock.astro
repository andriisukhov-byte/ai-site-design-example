---
import type { PageBlock } from '@acme/blocks';
import FormattedText from '../../FormattedText.astro';
import '../../../styles/blocks/_feature-grid.scss';

type FeatureGridBlock = Extract<PageBlock, { type: 'feature-grid' }>;

interface Props {
  block: FeatureGridBlock;
}

const { block } = Astro.props;
const background = block.background === 'gray' ? 'gray' : 'white';
const columns = block.columns === 2 || block.columns === 3 ? block.columns : 4;
const cards = (block.cards ?? []).filter((card) => Boolean(card.title?.trim() || card.description?.trim()));
const hasHeader = Boolean(block.eyebrow?.trim() || block.title?.trim() || block.description?.trim());
const rootClass = `feature-grid feature-grid--bg-${background} feature-grid--cols-${columns}`;

const iconMarkupByName: Record<string, string> = {
