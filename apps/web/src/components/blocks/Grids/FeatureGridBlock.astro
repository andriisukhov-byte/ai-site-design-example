  'messages-square': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v5ZM18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  bot: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 8V4M8 12h8M8 12a4 4 0 1 1 8 0v4a4 4 0 0 1-4 4h0a4 4 0 0 1-4-4v-4ZM6 19v-3M18 19v-3M9 15h.01M15 15h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  'file-stack': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M21 7H8a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1ZM4 17v-7M4 7h.01M4 12h.01M17 2v3a1 1 0 0 1-1 1h-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  'audio-lines': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M2 10v3M6 6v11M10 3v17M14 8v7M18 5v13M22 10v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  smartphone: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="5" y="2" width="14" height="20" rx="2" stroke="currentColor" stroke-width="2"/><path d="M12 18h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  'multi-agent': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="6" r="3" stroke="currentColor" stroke-width="2"/><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="18" r="3" stroke="currentColor" stroke-width="2"/><path d="m10 8-3 7M14 8l3 7M9 18h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  'add-business': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 21V8a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v6M3 21h12M3 21V12M21 14v7m-3.5-3.5h7M7 7V3a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  'design-services': '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m15 4 5 5M4 20 20 4M14 4l6 6M5 5v4M3 7h4M19 15v4M17 17h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
