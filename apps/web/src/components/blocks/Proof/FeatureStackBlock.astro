---
import { readFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

import type { PageBlock } from '@acme/blocks';
import FormattedText from '../../FormattedText.astro';
import '../../../styles/blocks/_feature-stack.scss';

type FeatureStackBlock = Extract<PageBlock, { type: 'feature-stack' }>;

type Props = {
  block: FeatureStackBlock;
};

const { block } = Astro.props;
const sourceDir = dirname(fileURLToPath(import.meta.url));
const iconDir = resolve(sourceDir, '../../../../public/assets/blocks/feature-stack/icons');
const allowedIcons = new Set(['network', 'shield-ellipsis', 'database', 'brain', 'shield-check', 'gauge', 'cpu', 'zap']);
const iconCache = new Map<string, string>();

function iconMarkup(icon?: string): string {
  const key = allowedIcons.has(icon ?? '') ? icon! : 'network';
  const cached = iconCache.get(key);

  if (cached) {
    return cached;
  }

  try {
    const markup = readFileSync(resolve(iconDir, `${key}.svg`), 'utf8');
    iconCache.set(key, markup);
    return markup;
  } catch {
    return '';
  }
}
---

<section class="feature-stack">
  <div class="feature-stack__container container-wide">
    <div class="feature-stack__layout">
      <header class="feature-stack__header">
        {block.title && (
          <h2 class="feature-stack__title">
            <FormattedText text={block.title} />
          </h2>
        )}

        {block.description && (
          <p class="feature-stack__description">
            <FormattedText text={block.description} />
          </p>
        )}
      </header>

      {block.cards.length > 0 && (
        <div class="feature-stack__cards">
          {block.cards.map((card) => (
            <article class="feature-stack__card">
              <span class="feature-stack__card-icon" aria-hidden="true">
                {card.customIcon?.src ? (
                  <img
                    class="feature-stack__custom-icon"
                    src={card.customIcon.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Fragment set:html={iconMarkup(card.icon)} />
                )}
              </span>

              <div class="feature-stack__card-content">
                {card.title && (
                  card.href ? (
                    <a class="feature-stack__card-title feature-stack__card-title--link" href={card.href} target="_blank" rel="noopener noreferrer">
                      {card.title}
                    </a>
                  ) : (
                    <h3 class="feature-stack__card-title">{card.title}</h3>
                  )
                )}

                {card.description && <p class="feature-stack__card-description">{card.description}</p>}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>

    {block.infoNote && (
      <aside class="feature-stack__note">
        <span class="feature-stack__note-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
        </span>
        <p class="feature-stack__note-text">{block.infoNote}</p>
      </aside>
    )}
  </div>
</section>
