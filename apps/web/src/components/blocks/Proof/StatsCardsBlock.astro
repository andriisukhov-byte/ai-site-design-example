---
import type { PageBlock } from '@acme/blocks';
import FormattedText from '../../FormattedText.astro';

import '../../../styles/blocks/_stats-cards.scss';

type StatsCardsBlock = Extract<PageBlock, { type: 'stats-cards' }>;

const { block } = Astro.props as { block: StatsCardsBlock };

const iconPaths: Record<string, string> = {
  'trending-up': '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  'users-round': '<path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20a7 7 0 0 0-5-6.7"/><path d="M17 3.3a5 5 0 0 1 0 9.4"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.8-1.6l9-11A1 1 0 0 1 14 2v7h6a1 1 0 0 1 .8 1.6l-9 11A1 1 0 0 1 10 21v-7Z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  'fast-forward': '<polygon points="13 19 22 12 13 5 13 19"/><polygon points="2 19 11 12 2 5 2 19"/>',
  star: '<polygon points="12 2 15.1 8.3 22 9.3 17 14.2 18.2 21 12 17.8 5.8 21 7 14.2 2 9.3 8.9 8.3 12 2"/>',
  'heart-handshake': '<path d="M19.5 12.6 12 20l-7.5-7.4a5 5 0 0 1 7.1-7.1l.4.4.4-.4a5 5 0 0 1 7.1 7.1Z"/><path d="m8 13 2-2 2 2 2-2 2 2"/>',
};

function iconMarkup(icon?: string): string {
  return iconPaths[icon ?? ''] ?? iconPaths['trending-up'];
}

function iconWithGradient(icon?: string): string {
  return iconMarkup(icon).replaceAll('stroke="currentColor"', 'stroke="url(#stats-cards-icon-gradient)"');
}
---

<section class:list={['stats-cards', `stats-cards--${block.background}`]}>
  <svg class="stats-cards__svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="stats-cards-icon-gradient" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#3A87D9" />
        <stop offset="0.25" stop-color="#2F1A6B" />
        <stop offset="0.5" stop-color="#200000" />
        <stop offset="0.75" stop-color="#AD3822" />
        <stop offset="1" stop-color="#F7A75F" />
      </linearGradient>
    </defs>
  </svg>
  <div class="stats-cards__container container-wide">
    <header class="stats-cards__header">
      <h2 class="stats-cards__title">
        <FormattedText text={block.title} />
      </h2>

      {block.subtitle && (
        <p class="stats-cards__subtitle">
          <FormattedText text={block.subtitle} />
        </p>
      )}
    </header>

    <div class="stats-cards__grid">
      {block.items.map((item) => (
        <article class="stats-cards__card">
          <div class="stats-cards__card-head">
            <span class="stats-cards__card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" set:html={iconWithGradient(item.icon)} />
            </span>
            <h3 class="stats-cards__card-heading">
              <FormattedText text={item.heading} />
            </h3>
          </div>

          <div class="stats-cards__card-body">
            <p class="stats-cards__card-value">{item.value}</p>
            <p class="stats-cards__card-label">
              <FormattedText text={item.label} />
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
