          <circle class="capability-trio__trace-dot capability-trio__trace-dot--card" cx="534" cy="464" r="6" />
          <circle class="capability-trio__trace-dot capability-trio__trace-dot--node" cx="596" cy="389" r="7" />
        </g>
      </svg>

      <div class="capability-trio__center" data-center>
        <span class="capability-trio__center-glow" aria-hidden="true"></span>
        <span class="capability-trio__center-inner">
          <span class="capability-trio__center-label">{centerLabel}</span>
        </span>
      </div>

      {cards.map((card, index) => {
        const cardClass = ['capability-trio__card', `capability-trio__card--${index + 1}`, card.highlighted && 'capability-trio__card--highlighted'].filter(Boolean).join(' ');
        return (
          <article class={cardClass}>
            <span class="capability-trio__badge" aria-hidden="true">
              {card.customIcon?.src ? (
                <img class="capability-trio__badge-icon-img" src={card.customIcon.src} alt="" loading="lazy" decoding="async" />
              ) : (
                <Fragment set:html={iconMarkup(card.icon)} />
              )}
            </span>
            {card.title && <h3 class="capability-trio__card-title"><FormattedText text={card.title} /></h3>}
            {card.description && <p class="capability-trio__card-description"><FormattedText text={card.description} /></p>}
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  import '../../../scripts/capability-trio';
</script>
