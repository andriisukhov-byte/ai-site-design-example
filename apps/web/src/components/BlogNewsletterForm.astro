---
import { formEndpointFor, formSuccessRedirects } from '../data/forms';
import FormTrackingFields from './FormTrackingFields.astro';

---

<form
  class="blog-newsletter__form"
  action={formEndpointFor('blog-subscribe')}
  method="post"
  data-acme-form
  data-success-redirect={formSuccessRedirects.newsletter}
>
  <input type="hidden" name="formIntent" value="blog-subscribe" />
  <input type="hidden" name="successRedirect" value={formSuccessRedirects.newsletter} />
  <FormTrackingFields />
  <input class="blog-newsletter__honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="form_text_block-email-box">
    <div class="form_text_block-email-box-email">
      <div class="form_text_block-sub">Email<span>*</span></div>
      <div class="form_text_block-email">
        <input class="blog-newsletter__input" type="email" name="email" autocomplete="email" placeholder="john.doe@mycompany.com" required />
        <button class="c-btn c-btn--primary" type="submit">SUBSCRIBE</button>
      </div>
    </div>
  </div>
  <p class="ca-form-status" data-form-status aria-live="polite"></p>
</form>
