---
import BlogArchive from '../../components/BlogArchive.astro';
import {
  createArchivePage,
  postsForCategory,
  productionTaxonomies,
} from '../../data/production-taxonomies';
import { getSourcePage, getSourcePages } from '../../data/source-pages';
import SiteLayout from '../../layouts/SiteLayout.astro';

import '../../styles/templates/_blog.scss';

const category = productionTaxonomies.postCategories.find(
  (item) => item.slug === Astro.params.slug,
);

if (!category) {
  return Astro.redirect('/404');
}

const blogPage = await getSourcePage('/blog/');
const sourcePages = await getSourcePages();

if (!blogPage) {
  throw new Error('Missing CMS document for /blog/.');
}

const page = createArchivePage(blogPage, category);
const items = postsForCategory(sourcePages, category.slug);
---

<SiteLayout page={page}>
  <BlogArchive
    items={items}
    firstPageCount={category.slug === 'article' ? 7 : undefined}
    perPage={category.slug === 'article' ? 8 : undefined}
  />
</SiteLayout>
