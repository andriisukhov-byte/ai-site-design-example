FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY . .
RUN npm ci

ARG S3_BUCKET
ARG S3_ENDPOINT
ARG S3_REGION=nyc3
ENV S3_BUCKET=$S3_BUCKET
ENV S3_ENDPOINT=$S3_ENDPOINT
ENV S3_REGION=$S3_REGION

ENV NODE_ENV=production
# Payload's config is loaded while Next builds. The application only connects
# to PostgreSQL when the container starts.
ENV DATABASE_URL=postgresql://build:build@postgres:5432/build
RUN npm run build --workspace @acme/cms

FROM node:22-bookworm-slim AS runtime

WORKDIR /app/apps/cms
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0

COPY --from=build /app/apps/cms/.next/standalone /app
COPY --from=build /app/apps/cms/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
